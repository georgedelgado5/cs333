!/.gitignore

#linux files
*~
.directory

#hidden files
.*

#ignore tar files
*.tar*

#ignore .txt files
*.txt

#ignore files from labs
*.[SD]err
*.[SD]out
*.j1bin
*.s1txt

#ignore bash scripts/files
*.bash

#c compile
*.obj
*.o

#.swp files
*.swp
*.swo

#executables
*.out
*.exe

#relative directories
#lab0
/labs/lab0
#lab1
#lab2
/labs/lab2/prince_of_aragon.h
#lab3
/labs/lab3/*.md
/labs/lab3/*.bash
/labs/lab3/md5_file.c
/labs/lab3/folio
